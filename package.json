{
  "name": "gsm.viz",
  "version": "2.3.0",
  "description": "web-based data visualization for risk-based monitoring",
  "module": "src/main.js",
  "main": "index.js",
  "scripts": {
    "build-windows": "npm run bundle & npm run format & npm run test & npm run link-bundles",
    "build": "npm run bundle && npm run format && npm run test && npm run link-bundles",
    "bundle": "esbuild src/main.js --banner:js=\"'use strict'\" --bundle --global-name=gsmViz --outfile=index.js --sourcemap && cp index.js examples/ && cp index.js.map examples/",
    "deploy": "node -e \"const fs=require('fs'); const html=fs.readFileSync('examples/index.html','utf8'); fs.writeFileSync('examples/index.html', html.replace('DEPLOYMENT_TIMESTAMP_PLACEHOLDER', new Date().toISOString()));\" && gh-pages -d examples",
    "format": "npm run format-src && npm run format-examples && npm run format-tests",
    "format-examples": "npx prettier --single-quote --tab-width=4 --write examples",
    "format-src": "npx prettier --single-quote --tab-width=4 --write src",
    "format-tests": "npx prettier --single-quote --tab-width=4 --write tests",
    "link-bundles": "rm examples/index.j* && ln -f index.j* examples",
    "local": "live-server --ignore=app,examples/app,examples/data,node_modules,react-app,src .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test-pattern": "jest --transformIgnorePatterns \"node_modules/(?!@gsmViz)/\" --env=jsdom",
    "update-data": "node examples/data/helpers/csv-to-json.js",
    "watch": "esbuild src/main.js --bundle --global-name=gsmViz --outfile=index.js --sourcemap --watch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gilead-BioStats/gsm.viz.git"
  },
  "keywords": [
    "rbqm",
    "rbm",
    "gsm",
    "rbqm",
    "risk-based",
    "monitoring",
    "data",
    "visualization"
  ],
  "author": "Gilead Sciences",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Gilead-BioStats/gsm.viz/issues"
  },
  "homepage": "https://github.com/Gilead-BioStats/gsm.viz#readme",
  "dependencies": {
    "@sgratzl/chartjs-chart-boxplot": "^3.10.0",
    "chart.js": "^3.9.1",
    "chartjs-plugin-annotation": "^2.0.1",
    "chartjs-plugin-datalabels": "^2.1.0",
    "d3": "^7.6.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.20.7",
    "@babel/core": "^7.20.7",
    "@babel/preset-env": "^7.20.2",
    "babel-jest": "^29.1.2",
    "csvtojson": "^2.0.13",
    "esbuild": "^0.25.0",
    "gh-pages": "^5.0.0",
    "jest": "^29.7.0",
    "jest-canvas-mock": "^2.5.2",
    "jest-environment-jsdom": "^29.7.0",
    "jsdoc": "^4.0.5",
    "live-server": "^1.2.2",
    "prettier": "^2.7.1"
  }
}
